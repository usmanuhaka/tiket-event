# Salin file ini menjadi .env lalu sesuaikan.
# Format DSN: user:password@tcp(host:port)/nama_database?opsi
#   parseTime=true          kolom DATETIME dibaca sebagai time.Time
#   loc=Asia%2FJakarta      time.Time dibaca dalam zona Asia/Jakarta
#   time_zone=%27%2B07%3A00%27   sesi database memakai +07:00, jadi NOW() juga waktu Jakarta

# database untuk aplikasi (XAMPP: user root tanpa password)
DB_DSN=root:@tcp(127.0.0.1:3306)/tiket_event?parseTime=true&loc=Asia%2FJakarta&time_zone=%27%2B07%3A00%27

# database khusus test integrasi; kosongkan jika ingin test DB di-skip
TEST_DB_DSN=root:@tcp(127.0.0.1:3306)/tiket_event_test?parseTime=true&loc=Asia%2FJakarta&time_zone=%27%2B07%3A00%27
