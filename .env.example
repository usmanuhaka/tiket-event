# Container database configuration. Replace both passwords before starting.
MYSQL_ROOT_PASSWORD=replace_with_a_random_root_password
MYSQL_DATABASE=tiket_event
MYSQL_USER=tiket_event
MYSQL_PASSWORD=replace_with_a_random_app_password

# Keep the username, password, and database in sync with MYSQL_* above.
# db is the MySQL container's network alias, not localhost.
DB_DSN='tiket_event:replace_with_a_random_app_password@tcp(db:3306)/tiket_event?parseTime=true&loc=Asia%2FJakarta&time_zone=%27%2B07%3A00%27'

# Optional: set this separately to run integration tests against a test database.
TEST_DB_DSN=
